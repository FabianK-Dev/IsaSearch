#!/usr/bin/env bash
#
# Private JVM launcher of the isasearch_* tools: isolates Solr's dependencies as FindFacts does.
# Usage: isasearch TOOL [ARGS ...]

isabelle scala_build || exit $?

eval "declare -a JAVA_ARGS=($ISABELLE_TOOL_JAVA_OPTIONS)"

classpath "$SOLR_JARS"

exec isabelle java "${JAVA_ARGS[@]}" --enable-native-access=ALL-UNNAMED isabelle.isasearch.Main "$@"
