title = IsaSearch
module = lib/isasearch.jar
resources = \
  ../benchmark/benchmark.csv:benchmark/ \
  ../benchmark/results/paper-baselines.json:benchmark/results/ \
  ../benchmark/results/UR_microsoft-Phi-3.5-mini-instruct_Phi-3-mini-4k-instruct.Q4_0.gguf.json:benchmark/results/
requirements = \
  env:ISABELLE_SCALA_JAR \
  env:SOLR_JARS
sources = \
  src/domain.scala \
  src/core.scala \
  src/inference.scala \
  src/index.scala \
  src/corpus.scala \
  src/search.scala \
  src/duplicates.scala \
  src/duplicate_report.scala \
  src/benchmark.scala \
  src/tools.scala \
  src/tests.scala
services = isabelle.isasearch.Tools
