title = IsaSearch
module = lib/isasearch.jar
requirements = \
  env:ISABELLE_SCALA_JAR \
  env:SOLR_JARS
sources = \
  src/domain.scala \
  src/core.scala \
  src/inference.scala \
  src/index.scala \
  src/corpus.scala \
  src/seed.scala \
  src/search.scala \
  src/duplicates.scala \
  src/duplicate_report.scala \
  src/benchmark.scala \
  src/compare.scala \
  src/tools.scala \
  src/tests.scala \
  src/integration_tests.scala
services = isabelle.isasearch.Tools
