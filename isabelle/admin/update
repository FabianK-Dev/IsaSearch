#!/usr/bin/env bash
#
# Keeps an index current with the registered AFP, analyses new AFP entries for duplicates, and
# releases every new state of the index with that analysis on GitHub (README.md). Meant for an
# hourly cron job; a run that finds nothing new exits silently.
#
# Usage: update -c CONFIG -i NAME [-f] [-e ENTRY] [-o DIR]
#   -c CONFIG build configuration of the index, tracked in this repository
#   -i NAME   index name
#   -f        build even if the AFP has not changed
#   -e ENTRY  analyse ENTRY for duplicates as well (repeatable)
#   -o DIR    dry run: write the assets and notes of the release to DIR instead of publishing
#             them on GitHub, even if they equal the last release, and the duplicate analysis
#             as well; needs no token and leaves the release and analysis state as it is

set -euo pipefail

CONFIG=""
INDEX=""
FORCE=false
ENTRIES=()
OUTPUT=""
while getopts "c:i:fe:o:" OPT; do
  case "$OPT" in
    c) CONFIG="$(cd "$(dirname "$OPTARG")" && pwd)/$(basename "$OPTARG")" ;;
    i) INDEX="$OPTARG" ;;
    f) FORCE=true ;;
    e) ENTRIES+=("$OPTARG") ;;
    o) OUTPUT="$OPTARG" ;;
    *) exit 2 ;;
  esac
done

[ -f "$CONFIG" ] && [ -n "$INDEX" ] || {
  echo "Usage: update -c CONFIG -i NAME [-f] [-e ENTRY] [-o DIR]" >&2
  exit 2
}
# A directory of the component checkout, whose commit a release names.
REPOSITORY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# GitHub API URL of the releases, shared with isasearch_import.
API="$(isabelle options -g isasearch_releases)"
AFP="$(isabelle getenv -b AFP_BASE)"
HOME_USER="$(isabelle getenv -b ISASEARCH_HOME_USER)"
STATE="$HOME_USER/update/$INDEX"
TOKEN_FILE="$HOME_USER/github_token"
RETRY_SECONDS=$((24 * 3600))
# Duplicate analyses by AFP revision, and the entries still to analyse.
DUPLICATES="$STATE/duplicates"
PENDING="$STATE/duplicates_pending"
PART_SIZE=1900M

mkdir -p "$STATE" "$HOME_USER/logs"
# Runs never overlap, also for different indexes.
exec 9>"$HOME_USER/update/lock"
flock -n 9 || exit 0

# json FILE EXPRESSION [ARGUMENT ...]: the value of a Python expression over the data d of FILE
# and the arguments a. Values of variables go into the arguments, never into the expression.
json() {
  python3 -c "import json, re, sys; d = json.load(open(sys.argv[1])); a = sys.argv[2:]; print($2)" \
    "$1" "${@:3}"
}
state() { cat "$STATE/$1" 2>/dev/null || true; }
log_start() {
  [ -n "${LOG:-}" ] && return
  LOG="$HOME_USER/logs/update-$(date -u +%Y%m%d-%H%M%S).log"
  exec > >(tee -a "$LOG") 2>&1
  echo "Log: $LOG"
}

INDEX_DIR="$HOME_USER/indexes/$INDEX"
generation() { echo "$INDEX_DIR/$(json "$INDEX_DIR/current.json" 'd["generation"]')"; }

# AFP

[ -n "$AFP" ] || {
  echo "No registered AFP" >&2
  exit 2
}
case "$(hg -R "$AFP" id -i)" in
  *+)
    echo "The AFP checkout $AFP has local changes" >&2
    exit 2
    ;;
esac
hg -R "$AFP" pull -q
TIP="$(hg -R "$AFP" id -i -r tip)"
# The AFP revision of the published index, until the first build of this script.
[ -n "$(state built)" ] ||
  json "$(generation)/manifest.json" 'd["provenance"]["afp"]["id"].rstrip("+")' >"$STATE/built"
BUILT="$(state built)"

if [ "$TIP" != "$BUILT" ] || "$FORCE"; then
  # Paths of the AFP root; a failing hg ends the run instead of reading as no change.
  CHANGED="$(hg -R "$AFP" status --rev "$BUILT" --rev "$TIP" path:thys path:metadata)"
  read -r FAILED FAILED_AT <<<"$(state failed)"
  if [ "${FAILED:-}" = "$TIP" ] && [ $(($(date +%s) - ${FAILED_AT:-0})) -lt $RETRY_SECONDS ] &&
    ! "$FORCE"; then
    :
  elif [ -z "$CHANGED" ] && ! "$FORCE"; then
    hg -R "$AFP" update -q -r "$TIP"
    echo "$TIP" >"$STATE/built"
  else
    log_start
    echo "Updating the AFP from $BUILT to $TIP"
    hg -R "$AFP" update -q -r "$TIP"
    if isabelle isasearch_index -c "$CONFIG" -i "$INDEX"; then
      # A new AFP entry adds its metadata file.
      hg --cwd "$AFP" status -a -n --rev "$BUILT" --rev "$TIP" path:metadata/entries |
        sed -n 's|^metadata/entries/\(.*\)\.toml$|\1|p' >>"$PENDING"
      echo "$TIP" >"$STATE/built"
      rm -f "$STATE/failed"
      isabelle isasearch_prune -i "$INDEX"
    else
      echo "$TIP $(date +%s)" >"$STATE/failed"
      echo "Index build failed; retrying $TIP after 24 hours or with a newer AFP" >&2
      exit 1
    fi
  fi
fi

# duplicate analysis

# The new entries and those of -e, against the index of the built revision. A new analysis of
# a revision repeats the entries of its earlier one, so that a release has one report. Releases
# publish the analysis in the state; a dry run (-o) reads the state but analyses into its
# output directory and changes nothing in the state.
BUILT="$(state built)"
STORED="$DUPLICATES/$BUILT/duplicates-afp-$BUILT"
if [ -n "$OUTPUT" ]; then REPORT="$OUTPUT/duplicates-afp-$BUILT"; else REPORT="$STORED"; fi
analysed() {
  [ -f "$STORED.json" ] && json "$STORED.json" '"\n".join(d["entries"] + d["missing_entries"])'
}
[ -n "$OUTPUT" ] || [ ${#ENTRIES[@]} -eq 0 ] || printf '%s\n' "${ENTRIES[@]}" >>"$PENDING"
REQUESTED="$( (cat "$PENDING" 2>/dev/null || true
  [ -z "$OUTPUT" ] || [ ${#ENTRIES[@]} -eq 0 ] || printf '%s\n' "${ENTRIES[@]}") | grep . || true)"
SELECTED="$( (echo "$REQUESTED"; [ -z "$REQUESTED" ] || analysed) | sort -u | grep . || true)"
read -r FAILED FAILED_AT <<<"$(state duplicates_failed)"
if [ -z "$SELECTED" ]; then
  :
elif [ -z "$OUTPUT" ] && [ "${FAILED:-}" = "$BUILT" ] &&
  [ $(($(date +%s) - ${FAILED_AT:-0})) -lt $RETRY_SECONDS ] && [ ${#ENTRIES[@]} -eq 0 ]; then
  :
else
  log_start
  echo "Duplicate analysis of" $SELECTED
  ANALYSIS="$(mktemp -d "$STATE/duplicates.XXXXXX")"
  ARGS=()
  for ENTRY in $SELECTED; do ARGS+=(-e "$ENTRY"); done
  if isabelle isasearch_duplicates -c "$CONFIG" -i "$INDEX" -k all "${ARGS[@]}" -D "$ANALYSIS"
  then
    NEW="$(find "$ANALYSIS" -name 'experiment_*.json')"
    mkdir -p "$(dirname "$REPORT")"
    mv "$NEW" "$REPORT.json"
    for VIEW in possible near-exact summary; do
      mv "${NEW%.json}_$VIEW.md" "${REPORT}_$VIEW.md"
    done
    [ -n "$OUTPUT" ] || rm -f "$PENDING" "$STATE/duplicates_failed"
  else
    [ -n "$OUTPUT" ] || echo "$BUILT $(date +%s)" >"$STATE/duplicates_failed"
    echo "Duplicate analysis failed; retrying after 24 hours or with a newer AFP" >&2
  fi
  rm -rf "$ANALYSIS"
fi
# A dry run without a new analysis shows the one that a release would publish.
[ -f "$REPORT.json" ] || REPORT="$STORED"

# release

# The section of the release notes on the duplicate analysis of the built revision.
duplicates_notes() {
  [ -f "${REPORT}_summary.md" ] || return 0
  printf '\n## Duplicate analysis of new entries\n\n'
  cat "${REPORT}_summary.md"
  printf '\nThe candidates with sources and links are in `%s` and `%s`, all evidence in `%s`.\n' \
    "$(basename "${REPORT}_near-exact.md")" "$(basename "${REPORT}_possible.md")" \
    "$(basename "$REPORT.json")"
}
DUPLICATES_ASSETS=("$REPORT.json" "${REPORT}_near-exact.md" "${REPORT}_possible.md")

# The token goes to curl as a configuration on its standard input, written by the shell's
# printf, so that it never appears among the arguments of a process.
github() {
  printf 'header = "Authorization: Bearer %s"\n' "$(<"$TOKEN_FILE")" |
    curl -sS --fail-with-body -K - -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" "$@"
}
upload() { # URL FILE
  echo "Uploading $(basename "$2")"
  github -X POST -H "Content-Type: application/octet-stream" -T "$2" "$1?name=$(basename "$2")" \
    >/dev/null
}

# An analysis that ends after the release of its revision is attached to that release: its
# assets replace those of an earlier analysis, its section the earlier section of the notes.
attach_duplicates() {
  local work release
  work="$(mktemp -d)"
  github "$API?per_page=100" >"$work/releases.json"
  # The release of this index: another index may have one of the same revision.
  release="$(json "$work/releases.json" \
    'next((str(r["id"]) for r in d
      if re.fullmatch(re.escape(a[0]) + r"\d{8}" + re.escape(a[1]), r["tag_name"])), "")' \
    "index-$INDEX-" "-afp-$BUILT")"
  if [ -z "$release" ]; then
    echo "No release of $BUILT for its duplicate analysis"
  else
    github "$API/$release" >"$work/release.json"
    for ASSET in $(json "$work/release.json" '" ".join(str(a["id"]) for a in d["assets"]
        if a["name"].startswith("duplicates-"))'); do
      github -X DELETE "$API/assets/$ASSET" >/dev/null
    done
    duplicates_notes >"$work/section.md"
    python3 -c 'import json, sys
r = json.load(open(sys.argv[1]))
body = r["body"].split("\n## Duplicate analysis of new entries\n")[0].rstrip("\n")
json.dump(dict(body=body + "\n" + open(sys.argv[2]).read()), open(sys.argv[3], "w"))' \
      "$work/release.json" "$work/section.md" "$work/request.json"
    github -X PATCH "$API/$release" --data-binary "@$work/request.json" >/dev/null
    for ASSET in "${DUPLICATES_ASSETS[@]}"; do
      upload "$(json "$work/release.json" 'd["upload_url"].split("{")[0]')" "$ASSET"
    done
    echo "Attached the duplicate analysis to $(json "$work/release.json" 'd["html_url"]')"
  fi
  sha256sum <"$REPORT.json" >"$STATE/duplicates_released"
  rm -rf "$work"
}
duplicates_released() {
  [ ! -f "$REPORT.json" ] || [ "$(sha256sum <"$REPORT.json")" = "$(state duplicates_released)" ]
}

if [ -z "$OUTPUT" ]; then
  if [ "$BUILT" = "$(state released)" ]; then
    if ! duplicates_released && [ -s "$TOKEN_FILE" ]; then
      log_start
      attach_duplicates
    fi
    exit 0
  fi
  [ -s "$TOKEN_FILE" ] || {
    echo "Missing GitHub token $TOKEN_FILE; not released" >&2
    exit 0
  }
fi
log_start
# The release names the commit that built it and the configuration in it, so that commit must
# be all there is.
CONFIG_NAME="$(git -C "$(dirname "$CONFIG")" ls-files --full-name -- "$(basename "$CONFIG")" \
  2>/dev/null || true)"
if [ -z "$OUTPUT" ] && { ! git -C "$REPOSITORY" diff --quiet HEAD || [ -z "$CONFIG_NAME" ]; }
then
  echo "The component checkout has local changes or does not track $CONFIG; not released" >&2
  exit 1
fi
[ -n "$CONFIG_NAME" ] || CONFIG_NAME="$CONFIG"

WORK="$STATE/release"
rm -rf "$WORK"
mkdir -p "$WORK/assets"
trap 'rm -rf "$WORK"' EXIT
# The generation as it is, ready to search; its manifest keeps the checksums of the corpus
# data, which identify the index across builds.
EXPORT="$(isabelle isasearch_export -F generation -i "$INDEX" -D "$WORK" | tail -n 1)"
FILES="$(json "$EXPORT/manifest.json" '[c["files"] for c in d["corpora"]]')"
if [ -z "$OUTPUT" ] && [ "$FILES" = "$(state released_files)" ]; then
  echo "Index data unchanged since the last release"
  echo "$BUILT" >"$STATE/released"
  exit 0
fi

DATE="$(date -u +%Y%m%d)"
TAG="index-$INDEX-$DATE-afp-$BUILT"
NAME="isasearch-$INDEX-$DATE-afp-$BUILT"
COMMIT="$(git -C "$REPOSITORY" rev-parse HEAD)"
# Only a release written with -o may come from a checkout with local changes.
git -C "$REPOSITORY" diff --quiet HEAD || COMMIT="$COMMIT with local changes"
echo "Packing $NAME"
tar -C "$(dirname "$EXPORT")" -cf - "$(basename "$EXPORT")" | zstd -q -T0 -10 |
  split -b "$PART_SIZE" -d -a 3 - "$WORK/assets/$NAME.tar.zst."
cp "$EXPORT/manifest.json" "$WORK/assets/$NAME.manifest.json"
[ ! -f "$REPORT.json" ] || cp "${DUPLICATES_ASSETS[@]}" "$WORK/assets/"
(cd "$WORK/assets" && sha256sum -- * >SHA256SUMS)

COUNTS="$(json "$EXPORT/manifest.json" \
  '", ".join(str(c["count"]) + " " + c["kind"] for c in d["corpora"])')"
MODEL="$(json "$EXPORT/manifest.json" 'd["corpora"][0]["recipe"]["model"]')"
SOURCES="$(json "$EXPORT/manifest.json" \
  'd["provenance"]["isabelle"]["identifier"] + " and the AFP " + d["provenance"]["afp"]["version"]')"
NOTES="$(
  cat <<EOF
The \`$INDEX\` index of IsaSearch for $SOURCES at revision \`$BUILT\`:
$COUNTS, embedded with $MODEL. Built by the component at $COMMIT with
\`$CONFIG_NAME\`.

Install it with the IsaSearch component (see its QUICKSTART.md):

    isabelle isasearch_import -R $TAG

Without \`-R\`, \`isasearch_import\` installs the release of the registered AFP's revision.
By hand: download the \`$NAME.tar.zst.*\` parts, then

    cat $NAME.tar.zst.* | zstd -d | tar -x
    isabelle isasearch_import -f isasearch-$INDEX -i $INDEX

\`SHA256SUMS\` lists the checksums of the assets, and \`$NAME.manifest.json\` is the
manifest of the index with its provenance.
$(duplicates_notes)
EOF
)"

if [ -n "$OUTPUT" ]; then
  mkdir -p "$OUTPUT"
  mv "$WORK"/assets/* "$OUTPUT"/
  printf '%s\n' "$NOTES" >"$OUTPUT/$NAME.notes.md"
  echo "Release assets of $TAG in $OUTPUT"
  exit 0
fi

REQUEST="$WORK/release.json"
python3 -c 'import json, sys; json.dump(dict(tag_name=sys.argv[1], target_commitish=sys.argv[2],
  name=sys.argv[3], body=sys.argv[4], draft=True), open(sys.argv[5], "w"))' \
  "$TAG" "$COMMIT" "$NAME" "$NOTES" "$REQUEST"
github -X POST "$API" --data-binary "@$REQUEST" >"$WORK/created.json"
RELEASE="$(json "$WORK/created.json" 'd["id"]')"
UPLOAD="$(json "$WORK/created.json" 'd["upload_url"].split("{")[0]')"
# A failed upload leaves no half release behind: the draft goes, and the next run retries.
trap 'github -X DELETE "$API/$RELEASE" > /dev/null || true; rm -rf "$WORK"' EXIT
for ASSET in "$WORK"/assets/*; do upload "$UPLOAD" "$ASSET"; done
github -X PATCH "$API/$RELEASE" -d '{"draft": false}' >"$WORK/published.json"
trap 'rm -rf "$WORK"' EXIT

echo "$BUILT" >"$STATE/released"
echo "$FILES" >"$STATE/released_files"
[ ! -f "$REPORT.json" ] || sha256sum <"$REPORT.json" >"$STATE/duplicates_released"
echo "Released $TAG: $(json "$WORK/published.json" 'd["html_url"]')"
