# The image contains code and Python dependencies only. Everything mutable lives on the /data
# volume at run time, so none of it belongs in the build context.

.git
.gitignore
.dockerignore
Dockerfile
compose.yaml

# Local state and generated corpora
.cache
.venv
.ruff_cache
__pycache__
*.pyc
*.log
artifacts
chroma_storages
reports
assets
assets_extracted

# Component checkouts, installed into the volume by src/installation.py
Isabelle
afp

# Not needed to run or test the application
paper
docs
benchmark/*.html
.pre-commit-config.yaml
.DS_Store
